        "doctor": ["child_env"],
        "run_full": ["child_env"],
        "bm25": ["http"],
        "serve": ["listener"],
        "answer_probe": ["http"],
        "answer_post": ["http"],
        "production_override": ["child_env"],
        "pid_stopped": ["listener"],
