        "lsp_verify": ["lsp"],
        "lsp_diagnostics": ["changed_files", "lsp"],
        "security_tests": ["secret_scan"],
        "provider_scan": ["provider_scan"],
        "secret_scan": ["secret_scan"],
        "provider_import": ["provider_scan"],
