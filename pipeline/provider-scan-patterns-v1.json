  ],
  "environment_keys": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY",
    "RESEND_API_KEY",
    "CLOUDFLARE_API_TOKEN",
    "CF_API_TOKEN"
  ],
  "provider_hosts": [
    "api.anthropic.com",
    "api.openai.com",
    "generativelanguage.googleapis.com",
    "api.resend.com",
    "workers.dev"
  ]
